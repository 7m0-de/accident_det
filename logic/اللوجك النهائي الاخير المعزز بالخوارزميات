# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الدالة الرئيسية run() — تسلسل عمل الخوارزميات في كل فريم              │
# │                                                                         │
# │  الترتيب الذي يمر به كل فريم عبر الخوارزميات:                          │
# │                                                                         │
# │  [1] قراءة الفريم من الفيديو                                            │
# │       ↓                                                                 │
# │  [2] GMC (رياضية/بصرية) → تعويض حركة الكاميرا                         │
# │       ↓                                                                 │
# │  [3] YOLOv10 + BoT-SORT (ذكاء اصطناعي) → كشف المركبات وتتبعها         │
# │       ↓                                                                 │
# │  [4] ClassLocker (منطق يدوي) → تثبيت فئة كل مركبة                     │
# │       ↓                                                                 │
# │  [5] OpticalFlow + KalmanTracker (رياضية) → حساب السرعة والاتجاه       │
# │       ↓                                                                 │
# │  [6] RiskEngine (منطق يدوي متعدد الطبقات):                             │
# │       ├─ KinematicModel TTC (رياضية) → وقت التصادم المتوقع             │
# │       ├─ BayesianFusion (إحصائية) → احتمالية التصادم                   │
# │       ├─ FSM States (منطق يدوي) → تحديث حالة المركبات                  │
# │       └─ DBSCAN (تعلم آلي) → كشف التجمعات المرورية                    │
# │       ↓                                                                 │
# │  [7] FireDetectorAI (ذكاء اصطناعي) → كشف الحريق والدخان               │
# │       ↓                                                                 │
# │  [8] draw() (منطق يدوي) → رسم النتائج على الفريم                       │
# │       ↓                                                                 │
# │  [9] حفظ الفيديو + ملفات JSON/CSV/TXT                                  │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
def run(video_path: Optional[str] = None) -> dict:
    if video_path is None:
        video_path = _upload_video()
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        raise RuntimeError(f"Cannot open: {video_path}")
    fps   = cap.get(cv2.CAP_PROP_FPS) or 30.
    W     = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))  or 1280
    H_vid = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)) or 720
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
    skip = 1
    if fps > 45: skip = 2
    elif fps > 25: skip = 1
    out_fps = fps / max(1, skip)
    writer = cv2.VideoWriter(C.OUT_VIDEO, cv2.VideoWriter_fourcc(*"mp4v"), out_fps, (W, H_vid))
    if not writer.isOpened():
        writer = cv2.VideoWriter(str(Path(C.OUT_VIDEO).with_suffix(".avi")), cv2.VideoWriter_fourcc(*"XVID"), out_fps, (W, H_vid))
    model   = _load_model()
    tracker = _make_botsort()
    locker  = ClassLocker(fps)
    motion  = MotionAnalyzer(fps)
    risk    = RiskEngine(fps, motion, W, H_vid)
    gmc     = GlobalMotionComp() if C.USE_GMC else None

    # ── إضافة كشف الحريق - تهيئة نموذج الحريق ──────────────────────────
    fire_model, use_fire = _load_fire_model()
    fire_detector = FireDetectorAI(fire_model, conf=C.FIRE_CONF) if use_fire else None
    # ────────────────────────────────────────────────────────────────────────

    min_w   = W * 0.020
    min_h   = H_vid * 0.015
    max_a   = W * H_vid * 0.45
    
    event_log: List[dict] = []
    seen_ids: set = set()
    cls_cnt: Dict[str,set] = defaultdict(set)
    fidx = 0; t0 = time.time()
    
    print(f"[START] {W}×{H_vid} @ {fps:.1f}fps | skip={skip} | GMC={C.USE_GMC} | FireAI={use_fire}")
    
    try:
        while True:
            ret, frame = cap.read()
            if not ret: break
            fidx += 1
            if C.MAX_FRAMES > 0 and fidx > C.MAX_FRAMES: break
            if skip > 1 and (fidx-1) % skip != 0: continue
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            # [2] GMC: تعويض حركة الكاميرا قبل أي معالجة للحركة
            gmc_transform = None
            if gmc is not None:
                gmc_transform = gmc.compensate(gray)
            # [3] YOLOv10 + BoT-SORT: كشف المركبات وتتبعها بالذكاء الاصطناعي
            res = model.track(frame, persist=True, tracker=tracker,
                              conf=C.CONF, iou=C.IOU_NMS,
                              imgsz=640, classes=C.CLASSES,
                              verbose=False)[0]
            vehicles = []
            if res.boxes is not None and res.boxes.id is not None:
                for box, tid, conf, cls in zip(res.boxes.xyxy.cpu().numpy(),
                                                res.boxes.id.cpu().numpy().astype(int),
                                                res.boxes.conf.cpu().numpy(),
                                                res.boxes.cls.cpu().numpy().astype(int)):
                    x1,y1,x2,y2 = map(int, box)
                    w = max(1,x2-x1); h = max(1,y2-y1)
                    if w<min_w or h<min_h or w*h>max_a: continue
                    if int(cls) not in C.NAMES: continue
                    cx,cy = (x1+x2)/2., (y1+y2)/2.
                    # [4] ClassLocker: تثبيت فئة المركبة
                    scls,_ = locker.get(int(tid), int(cls), fidx)
                    v = {"id":int(tid), "cls_id":scls, "cls_name":C.NAMES[scls],
                         "bbox":(x1,y1,x2,y2), "center":(cx,cy), "conf":float(conf),
                         "w":w, "h":h, "vx":0.,"vy":0.,"spd":0.,"acc":0.,
                         "heading":None,"hdelta":None,"mahal":0.,"frame":fidx,
                         "ts":round(fidx/fps,3)}
                    vehicles.append(v)
                    seen_ids.add(int(tid))
                    cls_cnt[C.NAMES[scls]].add(int(tid))
            # [5] MotionAnalyzer: حساب السرعة والاتجاه عبر OpticalFlow + Kalman
            motion.process_frame(vehicles, gray, fidx, gmc_transform)
            motion.cleanup({v["id"] for v in vehicles})
            # [6] RiskEngine: تحليل المخاطر وإصدار الأحداث
            events = risk.analyze(vehicles, fidx)

            # ── [7] كشف الحريق بالذكاء الاصطناعي ──────────────────────────
            if fire_detector is not None and vehicles:
                fire_events = fire_detector.analyze(frame, vehicles, fidx)
                for e in fire_events:
                    e["frame"] = fidx
                    e["ts"]    = round(fidx / fps, 3)
                    if e["type"] == "VEHICLE_FIRE":
                        print(f"  🔥 [FIRE]  f={fidx}: {e['message']}")
                    elif e["type"] == "VEHICLE_SMOKE":
                        print(f"  💨 [SMOKE] f={fidx}: {e['message']}")
                    event_log.append(_jclean(e))
                events = fire_events + events   # الحريق أولوية أعلى من كل شيء
            # ────────────────────────────────────────────────────────────────

            for e in events:
                e["frame"] = fidx; e["ts"] = round(fidx/fps, 3)
                if not e.get("persistent") and e["type"] not in ("VEHICLE_FIRE","VEHICLE_SMOKE"):
                    event_log.append(_jclean(e))
                    if e["type"] == "COLLISION": print(f"  [COLLISION] f={fidx}: {e['message']}")
                    elif e["level"] == "HIGH": print(f"  [HIGH] f={fidx}: {e['message']}")
                    elif e["level"] == "MEDIUM": print(f"  [MED] f={fidx}: {e['message']}")
            # [8] draw: رسم النتائج على الفريم
            frame = draw(frame, vehicles, events, risk.states, risk.reg)
            writer.write(frame)
            if fidx % 300 == 0: locker.cleanup(fidx)
            if fidx % 100 == 0:
                el = max(time.time()-t0, 1e-6)
                print(f"  Frame {fidx:6d} | {fidx/el:5.1f} fps | tracks={len(vehicles)} | events={len(event_log)}")
    finally:
        cap.release(); writer.release()
    elapsed = max(time.time()-t0, 1e-6)
    from collections import Counter
    lvls = Counter(e.get("level","?") for e in event_log)
    types = Counter(e.get("type","?") for e in event_log)

    # ── إضافة كشف الحريق - إحصائيات الحريق في الملخص ──────────────────
    fire_ids = fire_detector._confirmed if fire_detector else set()
    # ────────────────────────────────────────────────────────────────────────

    summary = {
        "video": video_path, "size": f"{W}x{H_vid}", "fps": fps,
        "frames_processed": fidx, "duration_s": round(total/fps, 2) if total else None,
        "proc_time_s": round(elapsed, 2), "proc_fps": round(fidx/elapsed, 2),
        "unique_ids": len(seen_ids), "class_counts":{k:len(v) for k,v in cls_cnt.items()},
        "total_collisions": len(risk.reg.all()), "event_levels": dict(lvls),
        "event_types": dict(types),
        "fire_detected_vehicles": list(fire_ids),       # إضافة كشف الحريق
        "total_fire_events": types.get("VEHICLE_FIRE",0),  # إضافة كشف الحريق
        "total_smoke_events": types.get("VEHICLE_SMOKE",0),# إضافة كشف الحريق
        "algorithms_used": ["YOLOv10", "BoT-SORT", "Kalman+OpticalFlow+GMC",
            "Kinematic TTC", "Predictive TTC", "Mahalanobis", "Bayesian Fusion",
            "Convoy Suppression", "Post-Impact FSM", "DBSCAN cluster",
            "Static obstacles (walls)",
            "YOLOv8n-Fire-Detection (keremberke)"]  # إضافة كشف الحريق
    }
    with open(C.OUT_EVENTS,"w",encoding="utf-8") as f:
        json.dump(_jclean(event_log), f, ensure_ascii=False)
    with open(C.OUT_SUMMARY,"w",encoding="utf-8") as f:
        json.dump(_jclean(summary), f, ensure_ascii=False, indent=2)
    risk.reg.save(C.OUT_REPORT, risk.states, time.strftime("%Y-%m-%d %H:%M:%S"))
    flds = ["frame","ts","level","type","ids","score","message"]
    with open(C.OUT_CSV,"w",newline="",encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=flds); w.writeheader()
        for e in event_log:
            w.writerow({k: (json.dumps(e.get("ids",[])) if k=="ids" else e.get(k,"")) for k in flds})
    print("\n"+"="*65)
    print(f"  Done | frames={fidx} | {elapsed:.1f}s | {fidx/elapsed:.1f} fps")
    print(f"  Tracked vehicles       : {len(seen_ids)}")
    for cls,ids in cls_cnt.items(): print(f"    {cls}: {len(ids)}")
    print(f"  Confirmed collisions   : {len(risk.reg.all())}")
    print(f"  🔥 Fire vehicles       : {len(fire_ids)}")          # إضافة كشف الحريق
    print(f"  💨 Smoke events        : {types.get('VEHICLE_SMOKE',0)}")  # إضافة كشف الحريق
    print(f"  Event levels  : {dict(lvls)}")
    print(f"  Event types   : {dict(types)}")
    print("="*65)
    if C.AUTO_DL:
        _download_outputs([C.OUT_VIDEO, C.OUT_EVENTS, C.OUT_CSV, C.OUT_REPORT, C.OUT_SUMMARY])
    return summary

if __name__ == "__main__":
    run()
