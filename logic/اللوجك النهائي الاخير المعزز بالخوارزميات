# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: دالة الرسم والتصور (draw)                                  │
# │  النوع: منطق يدوي (Visualization Logic)                                 │
# │  الفائدة: تُحوّل نتائج جميع الخوارزميات لمخرجات بصرية واضحة على       │
# │           كل فريم: صناديق ملونة حسب الخطورة، ملصقات بالسرعة والمعرف، │
# │           أسهم الاتجاه، شريط الحدث الأهم في الأعلى.                   │
# │  الآلية: يُعطي الأولوية للأحداث بترتيب: حريق > اصطدام > تحذير > منخفض│
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
def draw(frame: np.ndarray, vehicles: List[dict], events: List[dict], states: Dict[int,VehState], reg: Registry) -> np.ndarray:
    risk_col = {}
    for r in reg.all():
        for vid in r.ids: risk_col[vid] = (0,0,255)
    for e in events:
        col = {"HIGH":(0,0,255),"MEDIUM":(0,165,255),"LOW":(255,180,0)}.get(e["level"])
        if col:
            for vid in e.get("ids",[]):
                if vid not in risk_col or e["level"]=="HIGH":
                    risk_col[vid] = col

    # ── إضافة كشف الحريق - تلوين السيارات المحترقة ──────────────────────
    for e in events:
        if e["type"] == "VEHICLE_FIRE":
            for vid in e.get("ids", []):
                risk_col[vid] = (0, 30, 255)        # أحمر ناري داكن
        elif e["type"] == "VEHICLE_SMOKE":
            for vid in e.get("ids", []):
                if vid not in risk_col:
                    risk_col[vid] = (100, 100, 180) # رمادي بنفسجي
    # ────────────────────────────────────────────────────────────────────────

    for v in vehicles:
        x1,y1,x2,y2 = v["bbox"]; tid = v["id"]
        col = risk_col.get(tid, C.COLORS.get(v["cls_name"],(200,200,200)))
        thick = 3 if tid in risk_col else 2
        cv2.rectangle(frame, (x1,y1), (x2,y2), col, thick)
        suffix = ""
        if tid in states:
            s = states[tid].st
            if s == St.BURNED: suffix = " BURNED"
            elif s in (St.COLLIDED, St.POST): suffix = " COLLIDED"

        # ── إضافة كشف الحريق - إضافة FIRE/SMOKE للـ label ───────────────
        for e in events:
            if e["type"] == "VEHICLE_FIRE" and tid in e.get("ids", []):
                suffix = " 🔥FIRE"
                break
            elif e["type"] == "VEHICLE_SMOKE" and tid in e.get("ids", []):
                suffix = " 💨SMOKE"
        # ────────────────────────────────────────────────────────────────────

        mahal_str = f" M{v.get('mahal',0.):.1f}" if v.get("mahal",0.) > 2 else ""
        label = f"ID:{tid} {v['cls_name']} {v['conf']:.0%} {v['spd']:.1f}px/f{mahal_str}{suffix}"
        fs = cv2.FONT_HERSHEY_SIMPLEX; sc = 0.46
        (tw,th),_ = cv2.getTextSize(label, fs, sc, 1)
        bw = max(1, x2-x1)
        if tw > bw-4:
            sc = max(0.28, sc*(bw-4)/max(tw,1))
            (tw,th),_ = cv2.getTextSize(label, fs, sc, 1)
        ty = y1-4 if y1-th-8 >= 0 else y1+th+6
        cv2.rectangle(frame, (x1,ty-th-3), (x1+tw+4,ty+2), col, -1)
        cv2.putText(frame, label, (x1+2,ty), fs, sc, (0,0,0), 1, cv2.LINE_AA)
        cx,cy = map(int, v["center"])
        vx = int(v.get("vx",0)*8); vy = int(v.get("vy",0)*8)
        if abs(vx)+abs(vy) > 2:
            cv2.arrowedLine(frame,(cx,cy),(cx+vx,cy+vy),col,2,tipLength=0.35)

    # ── إضافة كشف الحريق - شريط الحريق أعلى الكل ────────────────────────
    fire_evs  = [e for e in events if e["type"] == "VEHICLE_FIRE"]
    smoke_evs = [e for e in events if e["type"] == "VEHICLE_SMOKE"]
    high = [e for e in events if e["level"]=="HIGH" and e["type"] not in ("VEHICLE_FIRE","VEHICLE_SMOKE")]
    med  = [e for e in events if e["level"]=="MEDIUM" and e["type"] not in ("VEHICLE_FIRE","VEHICLE_SMOKE")]
    low  = [e for e in events if e["level"]=="LOW"]

    if fire_evs:
        cv2.rectangle(frame, (0,0), (frame.shape[1],46), (0,20,200), -1)
        cv2.putText(frame, fire_evs[0]["message"][:110], (10,32),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.72, (255,255,255), 2, cv2.LINE_AA)
    elif smoke_evs:
        cv2.rectangle(frame, (0,0), (frame.shape[1],46), (80,80,160), -1)
        cv2.putText(frame, smoke_evs[0]["message"][:110], (10,32),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.72, (255,255,255), 2, cv2.LINE_AA)
    elif high:   bcol,txt = (0,0,180),  high[0]["message"]; cv2.rectangle(frame,(0,0),(frame.shape[1],46),bcol,-1); cv2.putText(frame,txt[:110],(10,32),cv2.FONT_HERSHEY_SIMPLEX,0.72,(255,255,255),2,cv2.LINE_AA)
    elif med:    bcol,txt = (0,100,200),med[0]["message"];  cv2.rectangle(frame,(0,0),(frame.shape[1],46),bcol,-1); cv2.putText(frame,txt[:110],(10,32),cv2.FONT_HERSHEY_SIMPLEX,0.72,(255,255,255),2,cv2.LINE_AA)
    elif low:    bcol,txt = (50,80,150),low[0]["message"];  cv2.rectangle(frame,(0,0),(frame.shape[1],46),bcol,-1); cv2.putText(frame,txt[:110],(10,32),cv2.FONT_HERSHEY_SIMPLEX,0.72,(255,255,255),2,cv2.LINE_AA)
    # ────────────────────────────────────────────────────────────────────────

    return frame

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: كاشف الحريق بالذكاء الاصطناعي (FireDetectorAI)           │
# │  النوع: ذكاء اصطناعي — نموذج YOLOv8n مدرَّب مسبقاً على الحريق        │
# │         (keremberke/yolov8n-fire-detection من Hugging Face)             │
# │  الفائدة: يكشف الاشتعال والدخان في محيط كل مركبة مكتشفة بشكل          │
# │           مستقل عن خوارزميات التصادم، مما يُتيح إنذاراً مبكراً         │
# │           بالحرائق الناجمة عن الحوادث أو الأعطال الميكانيكية.          │
# │  الآلية:                                                                │
# │   (1) يوسّع ROI كل مركبة 60% للأعلى (لاصطياد اللهب فوقها)            │
# │   (2) يُشغّل نموذج YOLO على ROI الموسَّع                              │
# │   (3) يُراكم نتائج آخر 10 فريمات لكل مركبة                            │
# │   (4) يُؤكد الحريق عند ≥3 فريمات إيجابية والدخان عند ≥4 فريمات        │
# │   (5) بعد تأكيد الحريق يُثبّت الحالة نهائياً (لا تُمسح)              │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class FireDetectorAI:
    """
    كشف احتراق السيارات ودخانها بنموذج YOLOv8 مدرّب جاهز
    النموذج: keremberke/yolov8n-fire-detection
    يعمل على ROI موسّع لكل سيارة مكتشفة
    """
    def __init__(self, model: YOLO, conf: float = 0.45):
        self.model      = model
        self.conf       = conf
        self._confirmed : set = set()    # IDs محترقة مؤكدة — لا تُمسح أبداً
        self._hist      : Dict[int, deque] = defaultdict(
            lambda: deque(maxlen=10))    # تاريخ آخر 10 فريمات لكل مركبة

    def analyze(self, frame: np.ndarray,
                vehicles: List[dict], fidx: int) -> List[dict]:
        events = []
        h_fr, w_fr = frame.shape[:2]

        for v in vehicles:
            tid            = v["id"]
            x1, y1, x2, y2 = v["bbox"]

            # ── توسيع ROI لاصطياد اللهب فوق السيارة ──────────────────────
            pad_y = int((y2 - y1) * C.FIRE_PAD_Y)
            pad_x = int((x2 - x1) * C.FIRE_PAD_X)
            rx1 = max(0,    x1 - pad_x)
            ry1 = max(0,    y1 - pad_y)
            rx2 = min(w_fr, x2 + pad_x)
            ry2 = min(h_fr, y2)
            roi = frame[ry1:ry2, rx1:rx2]
            if roi.size == 0:
                continue

            # ── تشغيل نموذج الحريق على ROI ────────────────────────────────
            try:
                results   = self.model(roi, conf=self.conf, verbose=False)[0]
            except Exception:
                continue

            fire_det  = False
            smoke_det = False
            max_conf  = 0.0

            if results.boxes is not None and len(results.boxes):
                for box in results.boxes:
                    cls_id   = int(box.cls[0])
                    det_conf = float(box.conf[0])
                    max_conf = max(max_conf, det_conf)
                    if cls_id == 0:    # fire
                        fire_det  = True
                    elif cls_id == 1:  # smoke
                        smoke_det = True

            # ── تسجيل في التاريخ ───────────────────────────────────────────
            self._hist[tid].append({
                "fire" : fire_det,
                "smoke": smoke_det,
                "conf" : max_conf,
            })

            hist = self._hist[tid]
            if len(hist) < 4:    # انتظر 4 فريمات قبل أي قرار
                continue

            fire_frames  = sum(1 for s in hist if s["fire"])
            smoke_frames = sum(1 for s in hist if s["smoke"])
            avg_conf     = float(np.mean([s["conf"] for s in hist]))

            fire_ok  = fire_frames  >= C.FIRE_CONFIRM
            smoke_ok = smoke_frames >= C.SMOKE_CONFIRM

            if tid in self._confirmed or fire_ok:
                self._confirmed.add(tid)    # تثبيت نهائي — لا رجعة
                events.append({
                    "level"  : "HIGH",
                    "type"   : "VEHICLE_FIRE",
                    "ids"    : [tid],
                    "score"  : int(avg_conf * 100),
                    "message": f"🔥 احتراق مركبة! ID:{tid} ({v['cls_name']}) {avg_conf:.0%}",
                    "color"  : (0, 30, 255),
                })
            elif smoke_ok:
                events.append({
                    "level"  : "MEDIUM",
                    "type"   : "VEHICLE_SMOKE",
                    "ids"    : [tid],
                    "score"  : int(avg_conf * 100),
                    "message": f"💨 دخان مريب — ID:{tid} ({v['cls_name']}) {avg_conf:.0%}",
                    "color"  : (100, 100, 200),
                })

        return events
