# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: التدفق البصري المتناثر (Sparse Optical Flow - LK)         │
# │  النوع: خوارزمية رياضية/بصرية جاهزة (Lucas-Kanade عبر OpenCV)         │
# │  الفائدة: يقيس الإزاحة الفعلية لكل مركبة بين الفريمات بتتبع نقاط     │
# │           مميزة داخل صندوق المركبة، مما يُعطي سرعة واتجاه دقيقَين     │
# │           يُدمجان مع مرشح كالمان للحصول على تقدير نهائي موثوق.        │
# │  الآلية: يستخرج نقاط Shi-Tomasi داخل ROI كل مركبة، يتتبعها عبر       │
# │           هرم LK بين الفريم السابق والحالي، ثم يأخذ الوسيط (median)   │
# │           للإزاحة لمقاومة النقاط الشاذة، ويطرح تعويض GMC منها.        │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class OpticalFlow:
    def __init__(self):
        self._prev_gray = None
        self._prev_boxes = {}

    def estimate(self, gray: np.ndarray, vehicles: List[dict], gmc_transform=None) -> Dict[int, Optional[Tuple[float,float]]]:
        result = {}
        h, w = gray.shape[:2]
        if self._prev_gray is None:
            self._store(gray, vehicles)
            return {v["id"]: None for v in vehicles}
        
        for v in vehicles:
            tid = v["id"]
            pb = self._prev_boxes.get(tid)
            if pb is None:
                result[tid] = None
                continue
            x1,y1,x2,y2 = pb
            x1,y1 = max(0,x1), max(0,y1)
            x2,y2 = min(w-1,x2), min(h-1,y2)
            if x2-x1 < 5 or y2-y1 < 5:
                result[tid] = None
                continue
            mask = np.zeros_like(gray, dtype=np.uint8)
            mask[y1:y2, x1:x2] = 255
            pts = cv2.goodFeaturesToTrack(self._prev_gray, maxCorners=50,
                                          qualityLevel=0.2, minDistance=5, mask=mask)
            if pts is None or len(pts) < 3:
                result[tid] = None
                continue
            new_pts, status, _ = cv2.calcOpticalFlowPyrLK(self._prev_gray, gray, pts, None)
            if new_pts is None or status is None:
                result[tid] = None
                continue
            ok = status.reshape(-1) == 1
            if ok.sum() < 3:
                result[tid] = None
                continue
            delta = new_pts[ok].reshape(-1,2) - pts[ok].reshape(-1,2)
            dx, dy = float(np.median(delta[:,0])), float(np.median(delta[:,1]))
            # تعويض حركة الكاميرا إذا وجد
            if gmc_transform is not None and C.USE_GMC:
                # نطبق inverse للتعويض
                inv = cv2.invertAffineTransform(gmc_transform)
                cam_dx = inv[0,2]  # إزاحة الكاميرا التقريبية
                cam_dy = inv[1,2]
                dx -= cam_dx
                dy -= cam_dy
            result[tid] = (dx, dy)
        
        self._store(gray, vehicles)
        return result

    def _store(self, gray, vehicles):
        self._prev_gray = gray.copy()
        self._prev_boxes = {v["id"]: tuple(v["bbox"]) for v in vehicles}

