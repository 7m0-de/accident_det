# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: قفل الفئة (Class Locker)                                  │
# │  النوع: منطق يدوي (Rule-Based Logic)                                    │
# │  الفائدة: يمنع تذبذب تصنيف المركبة بين الفئات (مثلاً بين سيارة       │
# │           وشاحنة) بسبب اختلاف زاوية الرؤية، فيُثبّت فئة المركبة       │
# │           بعد مشاهدتها لفترة كافية.                                     │
# │  الآلية: يراقب تاريخ تصنيفات كل مركبة لأول ثانيتين، ثم يقفل          │
# │           الفئة الأكثر تكراراً ويمنع تغييرها لاحقاً.                   │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class ClassLocker:
    def __init__(self, fps: float):
        self._lf = max(1, int(fps * 2.0))
        self._first: Dict[int,int] = {}
        self._obs:   Dict[int,deque] = {}
        self._locked: Dict[int,int] = {}

    def get(self, tid: int, cls: int, fidx: int) -> Tuple[int, bool]:
        if tid not in self._first:
            self._first[tid] = fidx
            self._obs[tid] = deque(maxlen=60)
        if tid in self._locked:
            return self._locked[tid], True
        self._obs[tid].append(cls)
        cnt = defaultdict(int)
        for c in self._obs[tid]: cnt[c] += 1
        best = max(cnt, key=cnt.get)
        if fidx - self._first[tid] >= self._lf:
            self._locked[tid] = best
        return best, tid in self._locked

    def cleanup(self, fidx: int):
        dead = [t for t,f in self._first.items() if fidx-f > 300 and t in self._locked]
        for t in dead:
            self._first.pop(t, None)
            self._obs.pop(t, None)
            self._locked.pop(t, None)

