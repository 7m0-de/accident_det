# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: آلة الحالات المحدودة (Finite State Machine - FSM)         │
# │  النوع: منطق يدوي (Rule-Based / FSM)                                    │
# │  الفائدة: تُتيح تتبع "دورة حياة" كل مركبة عبر مراحل منطقية مرتبة:    │
# │           عادي ← اقتراب ← حرج ← اصطدام ← ما بعد التصادم ← محترق.    │
# │           هذا يمنع إصدار تنبيهات متكررة ومتضاربة، ويضمن أن حالة      │
# │           "الاصطدام" لا تُلغى إذا عادت المركبة لتبدو طبيعية.          │
# │  الآلية: قواعد انتقال صارمة — لا يمكن الرجوع للخلف بعد الاصطدام،     │
# │           والحالات المقفولة (COLLIDED/POST/BURNED) تقاوم الانتقال      │
# │           للأمام فقط وفق ترتيب _ORDER.                                 │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class St(Enum):
    NORMAL=auto(); APPROACHING=auto(); CRITICAL=auto()
    COLLIDED=auto(); POST=auto(); BURNED=auto()

_LOCKED = {St.COLLIDED, St.POST, St.BURNED}
_ORDER  = [St.COLLIDED, St.POST, St.BURNED]

class VehState:
    __slots__ = ("tid","st","partners","cf","ts","post_fr")
    def __init__(self, tid: int):
        self.tid=tid; self.st=St.NORMAL
        self.partners=[]; self.cf=None; self.ts=None; self.post_fr=0

    def go(self, new: St, **kw) -> bool:
        if self.st in _LOCKED:
            if new not in _ORDER or self.st not in _ORDER: return False
            if _ORDER.index(new) <= _ORDER.index(self.st): return False
        self.st = new
        for k,v in kw.items(): setattr(self, k, v)
        return True

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: سجل التصادمات ونظام عدم التكرار (Registry)                │
# │  النوع: منطق يدوي (Rule-Based)                                          │
# │  الفائدة: يحفظ كل تصادم مؤكد مرة واحدة فقط (بمفتاح frozenset للزوج)، │
# │           يمنع التسجيل المزدوج لنفس الحادث، ويُعيد إظهار التصادمات    │
# │           المؤكدة في كل فريم لاحق كـ"أحداث دائمة"، ويحفظ تقرير نصي.  │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
@dataclass
class CollRec:
    ids:     Tuple[int,int]
    frame:   int
    ts:      float
    iou:     float
    rel_spd: float
    bayes:   float
    mahal:   float
    ev:      dict
    msg:     str = field(default="", init=False)
    def __post_init__(self):
        a,b = sorted(self.ids); self.ids=(a,b)
        self.msg = f"Collision: #{a} & #{b} at t={self.ts:.2f}s"

class Registry:
    def __init__(self):
        self._r: Dict[frozenset, CollRec] = {}
    def add(self, r: CollRec) -> bool:
        k = frozenset(r.ids)
        if k in self._r: return False
        self._r[k] = r
        print(f"[COLLISION] frame={r.frame} t={r.ts:.2f}s bayes={r.bayes:.0%} mahal={r.mahal:.1f} {r.msg}")
        return True
    def has(self, a, b) -> bool: return frozenset((a,b)) in self._r
    def all(self) -> list: return list(self._r.values())
    def persistent(self, fidx: int, ts: float, states: Dict[int,VehState]) -> list:
        out = []
        for r in self._r.values():
            pst = {str(t): states[t].st.name for t in r.ids if t in states}
            out.append({"level":"HIGH","type":"COLLISION","ids":list(r.ids),
                        "score":int(r.bayes*100),"message":r.msg,"color":(0,0,255),
                        "frame":fidx,"ts":round(ts,3),"persistent":True,
                        "ev":{**r.ev,"pst":pst}})
        return out
    def save(self, path: str, states: Dict[int,VehState], gen: str):
        lines = ["COLLISION REPORT", f"Generated: {gen}", "", f"Total confirmed: {len(self._r)}", ""]
        for i,r in enumerate(self.all(), 1):
            a,b = r.ids
            pst = {t: states[t].st.name for t in r.ids if t in states}
            lines += [f"#{i}  CONFIRMED COLLISION", f"  Vehicles   : #{a} <-> #{b}",
                      f"  Time       : {r.ts:.2f}s  (frame {r.frame})", f"  IoU        : {r.iou:.4f}",
                      f"  Rel speed  : {r.rel_spd:.2f} px/f", f"  Bayes prob : {r.bayes:.0%}",
                      f"  Mahalanobis: {r.mahal:.2f}", f"  Post-state : {pst}", ""]
        Path(path).write_text("\n".join(lines), encoding="utf-8")

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: الاندماج البايزي (Bayesian Fusion)                         │
# │  النوع: خوارزمية رياضية إحصائية (نظرية بايز للاستدلال)                │
# │  الفائدة: تدمج إشارات متعددة ومتنوعة (تداخل الصناديق، السرعة النسبية، │
# │           وقت التصادم المتوقع، الكبح المفاجئ، شذوذ ماهالانوبيس...)     │
# │           في احتمالية واحدة نهائية للتصادم، مما يقلل التنبيهات         │
# │           الكاذبة مقارنة بأي شرط منفرد.                                │
# │  الآلية: يبدأ باحتمال مسبق PRIOR=1.5% ثم يُحدّثه بضرب نسب             │
# │           الأرجحية (Likelihood Ratios) لكل إشارة نشطة أو خاملة في     │
# │           فضاء اللوغاريتم (log-odds)، ثم يُحوّل النتيجة لاحتمالية.    │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class BayesianFusion:
    PRIOR_COLL = 0.015
    LIKELIHOODS = {
        "iou_high":      (0.88, 0.04),
        "iou_med":       (0.68, 0.12),
        "contact":       (0.82, 0.18),
        "ttc_critical":  (0.87, 0.07),
        "ttc_warning":   (0.62, 0.22),
        "rel_spd_high":  (0.77, 0.12),
        "sudden_decel":  (0.72, 0.10),
        "post_sig":      (0.90, 0.03),
        "impact_sig":    (0.86, 0.05),
        "mahal_high":    (0.70, 0.14),
        "convoy":        (0.06, 0.68),
    }
    @classmethod
    def compute(cls, flags: Dict[str, bool]) -> float:
        log_odds = math.log(cls.PRIOR_COLL / (1. - cls.PRIOR_COLL))
        for key, active in flags.items():
            if key not in cls.LIKELIHOODS: continue
            p_coll, p_norm = cls.LIKELIHOODS[key]
            if active:
                lr = p_coll / max(p_norm, 1e-9)
            else:
                lr = (1.-p_coll) / max(1.-p_norm, 1e-9)
            log_odds += math.log(max(lr, 1e-9))
        return float(1. / (1. + math.exp(-log_odds)))

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: النموذج الحركي للتنبؤ بالتصادم (Kinematic TTC Model)     │
# │  النوع: خوارزمية رياضية (ميكانيكا كلاسيكية + حساب المسافة)            │
# │  الفائدة: يُقدّر الوقت المتبقي حتى التصادم (Time-To-Collision - TTC)  │
# │           بطريقتين مستقلتين لزيادة الموثوقية قبل وقوع الحادث.         │
# │  الآلية:                                                                │
# │  (1) TTC حركي: يحسب تقاطع مسارَي المركبتين بالمعادلات التحليلية       │
# │      (حل معادلة درجة ثانية لأقل مسافة).                               │
# │  (2) TTC تنبؤي: يُشغّل مرشح كالمان للأمام خطوة-خطوة (حتى 2.5 ثانية) │
# │      ويتحقق متى يقل البُعد المتوقع عن عتبة الحجم المشترك.             │
# │  (3) زاوية الاقتراب: يحسب مدى توجه كل مركبة نحو الأخرى (dot product). │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class KinematicModel:
    @staticmethod
    def ttc_kinematic(v1: dict, v2: dict, fps: float, mot: MotionAnalyzer) -> Optional[dict]:
        x1,y1 = v1["center"]; x2,y2 = v2["center"]
        vx1,vy1 = mot.kal[v1["id"]].vel() if v1["id"] in mot.kal else (0.,0.)
        vx2,vy2 = mot.kal[v2["id"]].vel() if v2["id"] in mot.kal else (0.,0.)
        rx,ry   = x2-x1, y2-y1
        rvx,rvy = vx2-vx1, vy2-vy1
        rv2     = rvx*rvx + rvy*rvy
        if rv2 < 1e-6: return None
        dist    = math.sqrt(rx*rx + ry*ry)
        closing = -(rx*rvx + ry*rvy) / max(dist, 1e-6)
        if closing < 2.0: return None
        t_f  = -(rx*rvx + ry*rvy) / rv2
        if t_f <= 0: return None
        fdx  = rx + rvx*t_f; fdy = ry + rvy*t_f
        fdist= math.sqrt(fdx*fdx + fdy*fdy)
        thresh = max(80., 0.28*(_diag(v1)+_diag(v2)))
        if fdist > thresh * 1.3: return None
        return {"secs": t_f/fps, "fdist": fdist, "thresh": thresh, "closing": closing}
    @staticmethod
    def ttc_predictive(v1: dict, v2: dict, fps: float, mot: MotionAnalyzer) -> Optional[float]:
        k1 = mot.kal.get(v1["id"]); k2 = mot.kal.get(v2["id"])
        if not k1 or not k2: return None
        thresh = 0.28 * (_diag(v1) + _diag(v2))
        look   = int(fps * 2.5)
        for t in range(1, look+1):
            p1 = np.array(k1.pred(t))
            p2 = np.array(k2.pred(t))
            if np.linalg.norm(p1-p2) <= thresh:
                return t / fps
        return None
    @staticmethod
    def approach_angle(v1: dict, v2: dict) -> Optional[float]:
        h1, h2 = v1.get("heading"), v2.get("heading")
        if h1 is None or h2 is None: return None
        d1x,d1y = math.cos(math.radians(h1)), math.sin(math.radians(h1))
        d2x,d2y = math.cos(math.radians(h2)), math.sin(math.radians(h2))
        rx = v2["center"][0]-v1["center"][0]
        ry = v2["center"][1]-v1["center"][1]
        r  = math.sqrt(rx*rx+ry*ry)
        if r < 1e-6: return None
        rx /= r; ry /= r
        approach = d1x*rx + d1y*ry - (d2x*rx + d2y*ry)
        return float(approach)

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: محرك المخاطر الرئيسي (Risk Engine)                        │
# │  النوع: منطق يدوي متعدد الطبقات يُنسّق بين جميع الخوارزميات           │
# │  الفائدة: هو "المدير العام" للنظام — يستدعي كل الخوارزميات السابقة     │
# │           ويُنتج قائمة الأحداث النهائية لكل فريم. يشمل:               │
# │           • تحليل كل زوج من المركبات (تصادم، اقتراب، قافلة)           │
# │           • تحليل كل مركبة منفردة (كبح مفاجئ، توقف مطوّل، منعطف حاد) │
# │           • كشف التصادم مع الحواجز الثابتة (جدران الفريم)             │
# │           • تحليل التجمعات المرورية (DBSCAN)                           │
# │           • إدارة cooldown لمنع التنبيهات المتكررة                     │
# │           • تحديث حالات FSM لكل مركبة                                  │
# │  الآلية: يُكيّف تلقائياً معاملاته مع دقة الفيديو وسرعة الإطارات.      │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class RiskEngine:
    def __init__(self, fps: float, mot: MotionAnalyzer, W: int, H: int):
        self.fps    = max(fps, 1.0)
        self.mot    = mot
        self.reg    = Registry()
        self.states: Dict[int, VehState] = {}
        self._cool: Dict[str,int]        = {}
        self._stop: Dict[int,int]        = {}
        self._pair: Dict[str,dict]       = {}
        self._cluster_last = -9999
        # التكيف التلقائي
        scale = ((W/1280.) + (H/720.)) / 2.
        ff    = fps / 30.
        self.prox       = max(20, int(80 * scale))
        self.drad       = max(30, int(110 * scale))
        self.lnrby      = max(50, int(180 * scale))
        self.ceps       = max(40, int(130 * scale))
        self.safe_spd   = 1.2 * ff
        self.long_spd   = 2.5 * ff
        self.crel_spd   = 3.0 * ff
        self.clos_spd   = 2.5 * ff
        self.sud_dec    = -6.0 * ff
        self.min_dec_spd= 7.0 * ff
        self.long_fr    = max(1, int(fps * 7.0))
        self.burned_fr  = max(1, int(fps * 4.0))
        self.conf_fr    = 4   # 4 فريمات
        self.evt_cd     = max(1, int(fps * 4))
        self.clus_cd    = max(1, int(fps * 3))
        # حاجز ثابت افتراضي (جدران الفيديو)
        self.static_obstacles = self._build_static_obstacles(W, H)
        
    def _build_static_obstacles(self, W, H):
        """إنشاء حواجز ثابتة على أطراف الفيديو (محاكاة الجدران)"""
        margin = max(20, int(0.05 * W))
        obstacles = []
        obstacles.append({"id": -1, "name": "left_wall",   "bbox": (0, 0, margin, H),         "center": (margin/2, H/2)})
        obstacles.append({"id": -2, "name": "right_wall",  "bbox": (W-margin, 0, W, H),       "center": (W-margin/2, H/2)})
        obstacles.append({"id": -3, "name": "top_wall",    "bbox": (0, 0, W, margin),          "center": (W/2, margin/2)})
        obstacles.append({"id": -4, "name": "bottom_wall", "bbox": (0, H-margin, W, H),       "center": (W/2, H-margin/2)})
        return obstacles
    
    def _st(self, tid: int) -> VehState:
        return self.states.setdefault(tid, VehState(tid))
    
    def _cooled(self, k: str, f: int) -> bool:
        if f - self._cool.get(k, -9999) >= self.evt_cd:
            self._cool[k] = f; return True
        return False

    # ─────────────────────────────────────────────────────────────────────
    # تحليل زوج المركبات — هنا يدخل النظام بخوارزمية تحليل الأزواج:
    #   1. يبدأ بـ IoU (رياضية): قياس التداخل بين صندوقَي المركبتين
    #   2. يحسب الفجوة (gap) و المسافة (distance): رياضية يدوية
    #   3. يكشف حالة "تماس" (contact): منطق يدوي بعتبات ثابتة
    #   4. يحسب السرعة النسبية (rel_spd): رياضية يدوية
    #   5. يكشف تشكيل القافلة (convoy): منطق يدوي (اتجاه + سرعة)
    #   6. يستدعي TTC الحركي والتنبؤي: رياضية (KinematicModel)
    #   7. يستدعي BayesianFusion: إحصائية لإنتاج الاحتمالية النهائية
    #   8. يتخذ قرار التأكيد أو التحذير بناءً على عتبة البايز
    # ─────────────────────────────────────────────────────────────────────
    def _analyze_pair(self, v1: dict, v2: dict, fidx: int) -> Optional[dict]:
        pk = f"{min(v1['id'],v2['id'])}_{max(v1['id'],v2['id'])}"
        iou    = _iou(v1["bbox"], v2["bbox"])
        dist   = _dist(v1["center"], v2["center"])
        gap    = _gap(v1["bbox"], v2["bbox"])
        glim   = min(45., max(12, 0.05*(_diag(v1)+_diag(v2))))
        contact= iou >= 0.30 or gap <= glim
        vx1,vy1 = (v1["vx"],v1["vy"])
        vx2,vy2 = (v2["vx"],v2["vy"])
        rel_spd = math.sqrt((vx1-vx2)**2 + (vy1-vy2)**2)
        hdiff  = _adiff(v1.get("heading"), v2.get("heading"))
        convoy = (hdiff is not None and hdiff <= 35.0 and rel_spd <= 2.5 * self.fps/30.)
        ttc_k  = KinematicModel.ttc_kinematic(v1, v2, self.fps, self.mot)
        ttc_p  = KinematicModel.ttc_predictive(v1, v2, self.fps, self.mot)
        ttc_s  = None
        if ttc_k: ttc_s = ttc_k["secs"]
        if ttc_p: ttc_s = min(ttc_s, ttc_p) if ttc_s else ttc_p
        approach = KinematicModel.approach_angle(v1, v2)
        mahal_max = max(v1.get("mahal", 0.), v2.get("mahal", 0.))
        ps = self._pair.setdefault(pk, {"cf":0,"scf":0,"lf":fidx,"maxspd":0.,"minacc":0.})
        consec = (fidx - ps["lf"]) <= 2
        ps["cf"]  = (ps["cf"]+1 if consec else 1) if contact else 0
        both_slow = (v1["spd"] <= self.safe_spd and v2["spd"] <= self.safe_spd)
        ps["scf"] = (ps["scf"]+1 if consec else 1) if (contact and both_slow) else 0
        ps["lf"]  = fidx
        ps["maxspd"] = max(self.mot.max_spd(v1["id"]), self.mot.max_spd(v2["id"]))
        ps["minacc"] = min(self.mot.min_acc(v1["id"]), self.mot.min_acc(v2["id"]))
        impact_sig = contact and not convoy and (rel_spd >= self.crel_spd or v1["acc"] <= self.sud_dec or v2["acc"] <= self.sud_dec or ps["minacc"] <= self.sud_dec)
        post_sig = (ps["scf"] >= self.conf_fr and ps["maxspd"] >= 5.0 and contact)
        flags = {
            "iou_high":      iou >= 0.45,
            "iou_med":       iou >= 0.30,
            "contact":       contact,
            "ttc_critical":  ttc_s is not None and ttc_s <= 0.6,
            "ttc_warning":   ttc_s is not None and ttc_s <= 1.8,
            "rel_spd_high":  rel_spd >= self.crel_spd,
            "sudden_decel":  (v1["acc"] <= self.sud_dec or v2["acc"] <= self.sud_dec),
            "post_sig":      post_sig,
            "impact_sig":    impact_sig,
            "mahal_high":    mahal_max >= 4.0,
            "convoy":        convoy,
        }
        bayes = BayesianFusion.compute(flags)
        ev = {"iou":round(iou,4), "dist":round(dist,2), "gap":round(gap,2),
              "contact":bool(contact), "rel_spd":round(rel_spd,3), "hdiff":hdiff,
              "convoy":bool(convoy), "both_slow":bool(both_slow), "approach":approach,
              "ttc_secs":ttc_s, "ttc_high":bool(ttc_s is not None and ttc_s<=0.6),
              "ttc_med":bool(ttc_s is not None and ttc_s<=1.8), "cf":ps["cf"], "scf":ps["scf"],
              "maxspd":round(ps["maxspd"],3), "minacc":round(ps["minacc"],3),
              "impact_sig":bool(impact_sig), "post_sig":bool(post_sig),
              "mahal_max":round(mahal_max,3), "bayes":round(bayes,4)}
        s1 = self._st(v1["id"]); s2 = self._st(v2["id"])
        confirmed = (post_sig or impact_sig or (ev["ttc_high"] and not convoy))
        if confirmed and bayes >= 0.74:
            s1.go(St.CRITICAL); s2.go(St.CRITICAL)
            r = CollRec(ids=(v1["id"],v2["id"]), frame=fidx, ts=round(fidx/self.fps,3),
                        iou=iou, rel_spd=rel_spd, bayes=bayes, mahal=mahal_max, ev=_jclean(ev))
            if self.reg.add(r):
                for s,oid in ((s1,v2["id"]),(s2,v1["id"])):
                    s.go(St.COLLIDED, partners=[oid], cf=fidx, ts=fidx/self.fps)
                    s.go(St.POST)
                return {"level":"HIGH","type":"COLLISION","ids":[v1["id"],v2["id"]],
                        "score":int(bayes*100),"message":r.msg,"color":(0,0,255),"ev":ev}
            elif self.reg.has(v1["id"],v2["id"]):
                return None
        warn = bayes >= 0.35 and not convoy
        if warn:
            ns = St.CRITICAL if ev["ttc_high"] else St.APPROACHING
            s1.go(ns); s2.go(ns)
            k = f"wp_{pk}"
            if not self._cooled(k, fidx): return None
            wt = ("TTC_WARNING" if ev["ttc_high"] else "CONTACT_WARNING" if contact else "PROXIMITY_WARNING")
            return {"level":"MEDIUM","type":wt,"ids":[v1["id"],v2["id"]],"score":int(bayes*100),
                    "message":f"WARNING({wt}): #{v1['id']}+#{v2['id']} bayes={bayes:.0%}",
                    "color":(0,165,255),"ev":ev}
        return None

    # ─────────────────────────────────────────────────────────────────────
    # تحليل المركبة المنفردة — يدخل النظام بمنطق يدوي لثلاثة سيناريوهات:
    #   1. الكبح المفاجئ (SUDDEN_DECEL): مقارنة التسارع بعتبة sud_dec
    #   2. المنعطف الحاد (SHARP_TURN): مقارنة تغير الاتجاه بعتبة 70°
    #   3. التوقف المطوّل في حركة مرورية (LONG_STOP): عداد الفريمات
    #   4. التصادم مع الحواجز الثابتة: IoU مع جدران الفريم
    # ─────────────────────────────────────────────────────────────────────
    def _analyze_single(self, v: dict, vehicles: List[dict], fidx: int) -> Optional[dict]:
        tid = v["id"]
        if v["acc"] <= self.sud_dec and v["spd"] >= self.min_dec_spd:
            k = f"dec_{tid}"
            if self._cooled(k, fidx):
                return {"level":"MEDIUM","type":"SUDDEN_DECEL","ids":[tid],
                        "score":55,"message":f"Sudden decel: #{tid}","color":(0,165,255)}
        if v.get("hdelta") is not None and v["hdelta"] >= 70.0 and v["spd"] >= 5.0:
            k = f"trn_{tid}"
            if self._cooled(k, fidx):
                return {"level":"LOW","type":"SHARP_TURN","ids":[tid],"score":30,
                        "message":f"Sharp turn: #{tid}","color":(255,180,0)}
        if v["spd"] < self.safe_spd:
            self._stop.setdefault(tid, fidx)
        else:
            self._stop.pop(tid, None)
        stopped_fr = fidx - self._stop.get(tid, fidx)
        if stopped_fr >= self.long_fr:
            nearby = any(o["id"]!=tid and o["spd"]>=self.long_spd and _dist(v["center"],o["center"])<=self.lnrby for o in vehicles)
            if nearby:
                k = f"ls_{tid}"
                if self._cooled(k, fidx):
                    return {"level":"HIGH","type":"LONG_STOP","ids":[tid],"score":75,
                            "message":f"Long stop in traffic: #{tid}","color":(0,0,200)}
        # كشف التصادم مع ثابت
        for obs in self.static_obstacles:
            iou = _iou(v["bbox"], obs["bbox"])
            gap = _gap(v["bbox"], obs["bbox"])
            contact = iou >= 0.25 or gap <= 15
            if contact and v["spd"] >= 3.0:
                k = f"stat_{tid}"
                if self._cooled(k, fidx):
                    return {"level":"HIGH","type":"STATIC_COLLISION","ids":[tid],
                            "score":85,"message":f"Vehicle #{tid} hit {obs['name']}",
                            "color":(0,0,255)}
        return None

    # ─────────────────────────────────────────────────────────────────────
    # تحديثات ما بعد التصادم — منطق FSM يدوي:
    #   يتابع المركبات بعد الاصطدام ويُحوّلها تلقائياً:
    #   COLLIDED → POST → BURNED (إذا ظلت ساكنة لـ burned_fr فريماً)
    # ─────────────────────────────────────────────────────────────────────
    def _post_updates(self, vehicles: List[dict], fidx: int) -> List[dict]:
        vmap = {v["id"]: v for v in vehicles}
        evs = []
        for r in self.reg.all():
            for tid in r.ids:
                s = self._st(tid); veh = vmap.get(tid)
                if s.st == St.COLLIDED: s.go(St.POST)
                if s.st == St.POST and veh:
                    if veh["spd"] <= 0.5: s.post_fr += 1
                    else: s.post_fr = 0
                    if s.post_fr >= self.burned_fr:
                        if s.go(St.BURNED):
                            evs.append({"level":"HIGH","type":"BURNED","ids":[tid],"score":90,
                                        "message":f"#{tid} stationary post-collision","color":(0,0,180)})
        return evs

    # ─────────────────────────────────────────────────────────────────────
    # الخوارزمية: DBSCAN للتجمعات المرورية
    # النوع: خوارزمية تعلم آلي غير خاضع للإشراف (Unsupervised ML) — جاهزة
    # الفائدة: يكشف التجمعات الكثيفة من المركبات (ازدحام مروري حاد)
    #          دون الحاجة لتحديد عدد المجموعات مسبقاً.
    # الآلية: يأخذ إحداثيات مراكز المركبات، يُشغّل DBSCAN بـ eps=ceps
    #         و min_samples=4، ثم يُبلّغ عن أكبر مجموعة.
    # ─────────────────────────────────────────────────────────────────────
    def _cluster(self, vehicles: List[dict], fidx: int) -> List[dict]:
        if fidx - self._cluster_last < self.clus_cd: return []
        if len(vehicles) < 4: return []
        coords = np.array([v["center"] for v in vehicles])
        if len(coords) < 4: return []
        clustering = DBSCAN(eps=self.ceps, min_samples=4).fit(coords)
        labels = clustering.labels_
        max_cluster = -1
        max_size = 0
        for l in set(labels):
            if l == -1: continue
            size = np.sum(labels == l)
            if size > max_size:
                max_size = size
                max_cluster = l
        if max_cluster == -1 or max_size < 4: return []
        indices = np.where(labels == max_cluster)[0]
        bv = [vehicles[i] for i in indices]
        cx = sum(v["center"][0] for v in bv) / len(bv)
        cy = sum(v["center"][1] for v in bv) / len(bv)
        self._cluster_last = fidx
        return [{"level":"LOW","type":"TRAFFIC_CLUSTER","ids":[v["id"] for v in bv],"score":25,
                 "message":f"Traffic cluster: {len(bv)} vehicles","color":(255,180,0),"center":(cx,cy)}]

    # ─────────────────────────────────────────────────────────────────────
    # دالة analyze — نقطة الدخول الرئيسية لمحرك المخاطر في كل فريم:
    #   الترتيب: أحداث دائمة → تحديثات FSM → مركبات منفردة
    #            → تحليل الأزواج → DBSCAN
    # ─────────────────────────────────────────────────────────────────────
    def analyze(self, vehicles: List[dict], fidx: int) -> List[dict]:
        ts = fidx / self.fps
        evs = self.reg.persistent(fidx, ts, self.states)
        evs += self._post_updates(vehicles, fidx)
        for v in vehicles:
            self._st(v["id"])
            e = self._analyze_single(v, vehicles, fidx)
            if e: evs.append(e)
        active_pk = set()
        for i in range(len(vehicles)):
            for j in range(i+1, len(vehicles)):
                if _dist(vehicles[i]["center"], vehicles[j]["center"]) > 280: continue
                pk = f"{min(vehicles[i]['id'],vehicles[j]['id'])}_{max(vehicles[i]['id'],vehicles[j]['id'])}"
                active_pk.add(pk)
                e = self._analyze_pair(vehicles[i], vehicles[j], fidx)
                if e: evs.append(e)
        for k in list(self._pair):
            if k not in active_pk and fidx - self._pair[k]["lf"] > 120:
                self._pair.pop(k)
        evs += self._cluster(vehicles, fidx)
        pri = {"HIGH":0,"MEDIUM":1,"LOW":2}
        evs.sort(key=lambda e: (pri.get(e["level"],9), -e.get("score",0)))
        return evs

