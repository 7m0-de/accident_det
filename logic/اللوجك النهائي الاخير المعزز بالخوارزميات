def _jclean(v):
    if isinstance(v, dict):             return {str(k): _jclean(x) for k, x in v.items()}
    if isinstance(v, (list, tuple)):    return [_jclean(x) for x in v]
    if isinstance(v, np.ndarray):       return v.tolist()
    if isinstance(v, np.integer):       return int(v)
    if isinstance(v, np.floating):      return float(v)
    return v

def _iou(b1, b2):
    x1, y1 = max(b1[0], b2[0]), max(b1[1], b2[1])
    x2, y2 = min(b1[2], b2[2]), min(b1[3], b2[3])
    inter = max(0., x2-x1) * max(0., y2-y1)
    a1 = max(1., (b1[2]-b1[0]) * (b1[3]-b1[1]))
    a2 = max(1., (b2[2]-b2[0]) * (b2[3]-b2[1]))
    return float(inter / max(a1+a2-inter, 1e-6))

def _gap(b1, b2):
    dx = max(b1[0]-b2[2], b2[0]-b1[2], 0.)
    dy = max(b1[1]-b2[3], b2[1]-b1[3], 0.)
    return math.sqrt(dx*dx + dy*dy)

def _dist(a, b):
    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2)

def _diag(v):
    return math.sqrt(float(v["w"])**2 + float(v["h"])**2)

def _adiff(a, b):
    if a is None or b is None: return None
    return abs((float(a)-float(b)+180.) % 360. - 180.)

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: تعويض الحركة العالمية (Global Motion Compensation - GMC)  │
# │  النوع: خوارزمية رياضية/بصرية جاهزة (مبنية على OpenCV)                │
# │  الفائدة: تُزيل تأثير حركة الكاميرا من حسابات السرعة والإزاحة،        │
# │           مما يجعل قياس حركة المركبات دقيقاً حتى لو تحركت الكاميرا.   │
# │  الآلية: يحسب التدفق البصري بين الفريمات المتتالية باستخدام نقاط     │
# │           مميزة (Shi-Tomasi corners)، ثم يقدّر التحويل الأفيني (Affine)│
# │           بين الفريمين باستخدام RANSAC لتصفية النقاط الشاذة،          │
# │           وينتج مصفوفة 2×3 تمثل إزاحة الكاميرا لتُطرح لاحقاً          │
# │           من حركة كل مركبة.                                             │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class GlobalMotionComp:
    """يعوض حركة الكاميرا بحساب التحويل بين الفريمات"""
    def __init__(self):
        self.prev_gray = None
        self.prev_pts = None
        self.transform = np.eye(2, 3, dtype=np.float32)  # affine 2x3
        
    def compensate(self, gray: np.ndarray) -> np.ndarray:
        """يعيد فريم مصححاً (أو المصفوفة للاستخدام في إزاحة الإحداثيات)"""
        if self.prev_gray is None:
            self.prev_gray = gray.copy()
            self.prev_pts = self._get_good_points(gray)
            return np.eye(2, 3)
        
        curr_pts = self._get_good_points(gray)
        if len(curr_pts) < 8 or len(self.prev_pts) < 8:
            self.prev_gray = gray.copy()
            self.prev_pts = curr_pts
            return np.eye(2, 3)
        
        # حساب optical flow بين النقاط القديمة والجديدة
        new_pts, status, _ = cv2.calcOpticalFlowPyrLK(
            self.prev_gray, gray, self.prev_pts, None,
            winSize=(21,21), maxLevel=3, criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 30, 0.01)
        )
        ok = (status == 1).reshape(-1)
        if np.sum(ok) < 8:
            self.prev_gray = gray.copy()
            self.prev_pts = curr_pts
            return np.eye(2, 3)
        
        src_pts = self.prev_pts[ok]
        dst_pts = new_pts[ok]
        
        # تقدير تحويل Affine (مقاوم للشواذ)
        try:
            M, _ = cv2.estimateAffinePartial2D(src_pts, dst_pts, method=cv2.RANSAC, ransacReprojThreshold=3.0)
            if M is None:
                M = np.eye(2, 3, dtype=np.float32)
        except:
            M = np.eye(2, 3, dtype=np.float32)
        
        # تحديث المخزن المؤقت
        self.prev_gray = gray.copy()
        self.prev_pts = self._get_good_points(gray)
        return M
    
    def _get_good_points(self, gray, max_corners=300):
        mask = np.ones_like(gray, dtype=np.uint8) * 255
        corners = cv2.goodFeaturesToTrack(gray, maxCorners=max_corners, qualityLevel=0.01, minDistance=7, mask=mask)
        if corners is None:
            return np.zeros((0,2), dtype=np.float32)
        return corners.reshape(-1,2).astype(np.float32)

# =============================================================================
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  الخوارزمية: مرشح كالمان (Kalman Filter)                               │
# │  النوع: خوارزمية رياضية إحصائية جاهزة                                  │
# │  الفائدة: تُتتبع موضع وسرعة كل مركبة بدقة عالية حتى مع الضوضاء       │
# │           والقياسات غير الدقيقة من الكاشف، كما تتنبأ بالموضع القادم.  │
# │  الآلية: يستخدم نموذج حركة خطياً (موضع + سرعة) مع مصفوفات انتقال F   │
# │           وقياس H، ويُوازن بين التنبؤ والقياس الفعلي عبر مكسب K       │
# │           (Kalman Gain). كما يحسب مسافة ماهالانوبيس للكشف عن          │
# │           الحركات الشاذة المفاجئة التي قد تشير إلى تصادم.              │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================
class KalmanTracker:
    def __init__(self):
        dt = 1.0
        self.F = np.array([[1,0,dt,0],[0,1,0,dt],[0,0,1,0],[0,0,0,1]], dtype=float)
        self.H = np.array([[1,0,0,0],[0,1,0,0]], dtype=float)
        self.Q = np.eye(4) * 0.1
        self.R = np.eye(2) * 1.0
        self.P = np.eye(4) * 10.0
        self.x = np.zeros((4,1), dtype=float)
        self.ok = False
        self._innovations: Deque[np.ndarray] = deque(maxlen=30)

    def update(self, cx: float, cy: float) -> Tuple[float, float]:
        if not self.ok:
            self.x[0,0]=cx; self.x[1,0]=cy; self.ok=True
            return cx, cy
        self.x = self.F @ self.x
        self.P = self.F @ self.P @ self.F.T + self.Q
        z = np.array([[cx],[cy]], dtype=float)
        innov = z - self.H @ self.x
        self._innovations.append(innov.flatten())
        S = self.H @ self.P @ self.H.T + self.R
        K = self.P @ self.H.T @ np.linalg.inv(S)
        self.x += K @ innov
        self.P = (np.eye(4) - K @ self.H) @ self.P
        return float(self.x[0,0]), float(self.x[1,0])

    def vel(self) -> Tuple[float, float]:
        return float(self.x[2,0]), float(self.x[3,0])

    def pred(self, t: int) -> Tuple[float, float]:
        f = np.linalg.matrix_power(self.F, max(0, t)) @ self.x
        return float(f[0,0]), float(f[1,0])

    def mahalanobis_anomaly(self, cx: float, cy: float) -> float:
        if len(self._innovations) < 5:
            return 0.0
        innov_arr = np.array(list(self._innovations))
        mu = innov_arr.mean(axis=0)
        cov = np.cov(innov_arr.T) + np.eye(2) * 1e-6
        z = np.array([cx - float(self.x[0,0]), cy - float(self.x[1,0])])
        diff = z - mu
        try:
            cov_inv = np.linalg.inv(cov)
            d2 = float(diff @ cov_inv @ diff)
            return math.sqrt(max(0., d2))
        except:
            return 0.0

