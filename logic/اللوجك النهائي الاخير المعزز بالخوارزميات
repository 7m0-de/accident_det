# دوال مساعدة للكولاب
# =============================================================================
def _make_botsort() -> str:
    try:
        import torch
        reid = (torch.cuda.is_available() and any(x in torch.cuda.get_device_name(0).lower() for x in ("a100","l4","v100","h100")))
    except: reid = False
    txt = "\n".join(["tracker_type: botsort", f"track_high_thresh: {C.CONF}", "track_low_thresh: 0.10",
                     f"new_track_thresh: {min(C.CONF+0.05,0.95):.2f}", f"track_buffer: {C.TRACK_BUFFER}",
                     f"match_thresh: {C.MATCH_THRESH}", "fuse_score: True", f"with_reid: {'true' if reid else 'false'}",
                     "model: auto", "proximity_thresh: 0.5", "appearance_thresh: 0.25", "gmc_method: sparseOptFlow", ""])
    Path(C.BOTSORT_YAML).write_text(txt, encoding="utf-8")
    return C.BOTSORT_YAML

# ─────────────────────────────────────────────────────────────────────────────
# تحميل نماذج الذكاء الاصطناعي:
#   _load_model    → نموذج YOLOv10/v8 للكشف عن المركبات وتتبعها
#                    النوع: ذكاء اصطناعي — شبكة عصبية عميقة (Deep Learning)
#   _load_fire_model → نموذج YOLOv8n-fire-detection للحريق والدخان
#                    النوع: ذكاء اصطناعي — نموذج مدرَّب مسبقاً جاهز (Pre-trained)
# ─────────────────────────────────────────────────────────────────────────────
def _load_model() -> YOLO:
    for m in [C.MODEL, *C.FALLBACKS]:
        try:
            print(f"[MODEL] Loading {m} …")
            return YOLO(m)
        except Exception as e:
            print(f"  skip {m}: {e}")
    raise RuntimeError("No YOLO model available.")

# ── إضافة كشف الحريق - تحميل نموذج الحريق ──────────────────────────────────
def _load_fire_model() -> Tuple[Optional[YOLO], bool]:
    """تحميل نموذج كشف الحريق — يعيد (model, success)"""
    try:
        print(f"[FIRE MODEL] Loading {C.FIRE_MODEL} …")
        m = YOLO(C.FIRE_MODEL)
        print("✅ Fire detection model loaded successfully")
        return m, True
    except Exception as e:
        print(f"⚠️  Fire model failed to load: {e}")
        print("   سيتم تخطي كشف الحريق والاستمرار بدونه")
        return None, False
# ────────────────────────────────────────────────────────────────────────────

def _upload_video() -> str:
    if IN_COLAB and _gfiles:
        print("Upload your video:")
        up = _gfiles.upload()
        if not up: raise RuntimeError("No file uploaded.")
        return next(iter(up))
    p = input("Video path: ").strip().strip('"')
    if not p: raise RuntimeError("No path given.")
    return p

def _download_outputs(paths: List[str]):
    if not (IN_COLAB and _gfiles): return
    for p in paths:
        if os.path.exists(p):
            try: _gfiles.download(p)
            except: pass

